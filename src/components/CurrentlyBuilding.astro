---
interface ProgressStep {
  label: string;
  state: 'current' | 'upcoming';
}

const steps: ProgressStep[] = [
  { label: 'Learning fundamentals', state: 'current' },
  { label: 'Applying to a project', state: 'upcoming' },
  { label: 'Shipping & documenting', state: 'upcoming' },
];

const skills = ['MATLAB', 'Python'];
---

<section id="currently-building" class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26" aria-labelledby="building-heading">
  <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
    <span class="w-6 h-px bg-accent inline-block"></span>
    Currently Building
  </p>

  <h2 id="building-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[22ch] mb-10">
    A new set of tools, in progress.
  </h2>

  <div class="building-panel exp-reveal" data-delay="0">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
      <span class="status-pill inline-flex items-center gap-2 rounded-full bg-accent-soft text-accent text-xs font-semibold tracking-wide uppercase px-3 py-1.5">
        <span class="status-dot" aria-hidden="true"></span>
        In progress
      </span>

      <div class="flex flex-wrap gap-2" aria-label="Skills currently being learned">
        {skills.map((skill) => (
          <span class="skill-chip inline-flex items-center rounded-md border border-hairline bg-paper text-ink text-xs font-semibold px-2.5 py-1">
            {skill}
          </span>
        ))}
      </div>
    </div>

    <p class="text-ink font-display font-semibold text-base md:text-lg leading-snug mb-3 max-w-[48ch]">
      Currently learning MATLAB and Python to bring more computational, data-driven tools into her engineering work.
    </p>

    <p class="text-ink-soft text-sm leading-relaxed max-w-[54ch]">
      The specific project is still taking shape — this panel will graduate into a full case study once it exists.
    </p>

    <div class="progress-footer mt-7 pt-6 border-t border-hairline">
      <ol class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-0">
        {steps.map((step, i) => (
          <li class="flex items-center gap-4 sm:flex-1">
            <div class="flex items-center gap-2.5 min-w-0">
              <span
                class:list={['progress-node shrink-0', step.state === 'current' && 'progress-node-current']}
                aria-hidden="true"
              ></span>
              <span
                class:list={[
                  'text-xs font-semibold truncate',
                  step.state === 'current' ? 'text-ink' : 'text-ink-soft',
                ]}
              >
                {step.label}
              </span>
            </div>
            {i < steps.length - 1 && <span class="progress-line hidden sm:block" aria-hidden="true"></span>}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .building-panel {
    position: relative;
    background: var(--color-accent-soft);
    border-left: 3px solid var(--color-accent);
    border-radius: 1rem;
    padding: 1.75rem 1.75rem 1.5rem;
  }

  .border-hairline { border-color: var(--color-hairline); }
  .bg-paper { background: var(--color-paper); }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent);
    display: inline-block;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.4); }
  }

  .progress-node {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-hairline);
    border: 2px solid var(--color-hairline);
  }

  .progress-node-current {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .progress-line {
    flex: 1;
    height: 1px;
    background: var(--color-hairline);
    margin: 0 0.75rem;
  }

  .exp-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .status-dot { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#currently-building .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#currently-building .exp-reveal').forEach((el) => observer.observe(el));
</script>