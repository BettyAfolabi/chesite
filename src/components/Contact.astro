---
// Contact.astro
const CONTACT = {
  email: 'elizabetafolabi@gmail.com',  
  resumeHref: '/resume/elizabeth-afolabi.pdf',
};
---

<section id="contact" class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26" aria-labelledby="contact-heading">
  <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
    <span class="w-6 h-px bg-accent inline-block"></span>
    Contact
  </p>

  <h2 id="contact-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[24ch] mb-4">
    Let's talk about process safety, simulation, or where I could add value.
  </h2>
  <p class="text-ink-soft max-w-[52ch] mb-10">
    Open to process, HSE, and simulation-adjacent roles. The fastest way to reach me is email — happy to send over my resume or set up a call.
  </p>

  <div class="grid md:grid-cols-[0.85fr_1.15fr] gap-8 md:gap-10 items-start">
    <!-- Contact details card -->
    <div class="contact-card exp-reveal" data-delay="0">
      <ul class="flex flex-col gap-5">
        <li class="flex items-start gap-3">
          <span class="contact-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16v16H4z" />
              <path d="m4 6 8 7 8-7" />
            </svg>
          </span>
          <div class="min-w-0">
            <span class="block text-xs uppercase tracking-widest text-ink-soft font-semibold mb-0.5">Email</span>
            <a href={`mailto:${CONTACT.email}`} class="contact-link break-all">{CONTACT.email}</a>
          </div>
        </li>

        <li class="flex items-start gap-3">
          <span class="contact-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <div class="min-w-0">
            <span class="block text-xs uppercase tracking-widest text-ink-soft font-semibold mb-0.5">Based in</span>
            <span class="font-medium text-ink">Nigeria · open to relocation and remote</span>
          </div>
        </li>
      </ul>

      <div class="mt-7 pt-6 border-t border-slate-200">
        <span class="block text-xs uppercase tracking-widest text-ink-soft font-semibold mb-3">Open to</span>
        <ul class="flex flex-wrap gap-2">
          {['Process engineering', 'HSE / Process safety', 'Simulation & modelling', 'Research & development'].map((item) => (
            <li class="text-xs font-semibold px-2.5 py-1.5 rounded-full border border-slate-200 text-ink">{item}</li>
          ))}
        </ul>
      </div>

      <a href={CONTACT.resumeHref} download class="resume-btn mt-8">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4" />
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
        </svg>
        Download resume
      </a>
    </div>

    <!-- Contact form: no backend, builds a pre-filled mailto:// on submit -->
    <form id="contact-form" class="contact-form exp-reveal" data-delay="1" data-contact-email={CONTACT.email}>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="cf-email">Your email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>

      <div class="field mt-4">
        <label for="cf-subject">Subject</label>
        <input id="cf-subject" name="subject" type="text" autocomplete="off" placeholder="Optional" />
      </div>

      <div class="field mt-4">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="submit-btn mt-5">
        Send message
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </button>

      <p id="cf-status" class="text-xs text-ink-soft mt-3 min-h-[1em]" role="status" aria-live="polite"></p>
      <p class="text-[0.7rem] text-ink-soft mt-1">
        This opens your email client with the message pre-filled — nothing is stored or sent to a server.
      </p>
    </form>
  </div>
</section>

<style>
  .contact-card {
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    border-radius: 1rem;
    padding: 1.75rem;
    height: fit-content;
  }
  .contact-icon {
    width: 2.25rem; height: 2.25rem; flex-shrink: 0;
    border-radius: 0.6rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .contact-link {
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .contact-link:hover,
  .contact-link:focus-visible { color: var(--color-accent); }

  .resume-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    width: 100%;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 600; font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .resume-btn:hover,
  .resume-btn:focus-visible { background: var(--color-accent); color: #fff; }

  .contact-form {
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    border-radius: 1rem;
    padding: 1.75rem;
  }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field label {
    font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-ink-soft);
  }
  .field input,
  .field textarea {
    font: inherit;
    color: var(--color-ink);
    background: var(--color-bg, #fff);
    border: 1px solid var(--color-hairline);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    resize: vertical;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .submit-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 0.6rem;
    border: none;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600; font-size: 0.875rem;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .submit-btn:hover { filter: brightness(0.92); }
  .submit-btn:active { transform: translateY(1px); }
  .submit-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .exp-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .exp-reveal { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#contact .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });

  const revealObserver = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#contact .exp-reveal').forEach((el) => revealObserver.observe(el));

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#cf-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.dataset.contactEmail ?? '';
    const name = (form.querySelector('#cf-name') as HTMLInputElement).value.trim();
    const fromEmail = (form.querySelector('#cf-email') as HTMLInputElement).value.trim();
    const subjectInput = (form.querySelector('#cf-subject') as HTMLInputElement).value.trim();
    const message = (form.querySelector('#cf-message') as HTMLTextAreaElement).value.trim();

    const subject = subjectInput || `Portfolio contact from ${name}`;
    const body = `${message}\n\n— ${name} (${fromEmail})`;
    const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (status) status.textContent = 'Opening your email client…';
    window.location.href = mailto;
  });
</script>