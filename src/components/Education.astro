---
interface EduEntry {
  degree: string;
  institution: string;
  date: string;
  honors?: string;
}

const edus: EduEntry[] = [
  {
    degree: 'BSc Chemical Engineering',
    institution: 'Obafemi Awolowo University (OAU)',
    date: '2018 — December 2024',
    honors: 'Second Class Upper',
  },
  {
    degree: 'WASSCE',
    institution: "Fiwasaye Girls' Grammar School",
    date: '2017',
  },
];
---

<section id="education" class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26" aria-labelledby="edu-heading">
  <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
    <span class="w-6 h-px bg-accent inline-block"></span>
    Education
  </p>

  <h2 id="edu-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[22ch] mb-10">
    Foundations in chemical engineering, from secondary school through university.
  </h2>

  <div class="edu-list max-w-2xl">
    {edus.map((edu, i) => (
      <div class="edu-item exp-reveal" data-delay={i}>
        <div class="edu-marker" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10 12 5 2 10l10 5 10-5Z" />
            <path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
          </svg>
        </div>
        <div class="edu-content">
          <div class="edu-top">
            <h3 class="font-display font-semibold text-base text-ink">{edu.degree}</h3>
            {edu.honors && <span class="edu-honors">{edu.honors}</span>}
          </div>
          <p class="text-sm text-ink-soft mt-1">{edu.institution}</p>
          <p class="text-xs text-ink-soft/80 mt-1 uppercase tracking-wide">{edu.date}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .edu-list { display: flex; flex-direction: column; gap: 2rem; }
  .edu-item { display: flex; gap: 1.25rem; position: relative; }
  .edu-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.375rem;
    top: 2.75rem;
    bottom: -2rem;
    width: 1px;
    background: var(--color-border);
  }
  .edu-marker {
    width: 2.75rem; height: 2.75rem; flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
  }
  .edu-content { padding-top: 0.35rem; }
  .edu-top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .edu-honors {
    display: inline-flex; align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.7rem; font-weight: 600;
  }
  .exp-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .exp-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#education .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#education .exp-reveal').forEach((el) => observer.observe(el));
</script>