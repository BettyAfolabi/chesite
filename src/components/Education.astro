---
import { Image } from 'astro:assets';
import portrait from '../assets/images/education/elizabeth-portrait.png';

interface EduEntry {
  degree: string;
  institution: string;
  date: string;
  honors?: string;
}

const edus: EduEntry[] = [
  {
    degree: 'BSc Chemical Engineering',
    institution: 'Obafemi Awolowo University (OAU)',
    date: '2018 — September 2024',
    honors: 'Second Class Upper',
  },
  {
    degree: 'WASSCE',
    institution: "Fiwasaye Girls' Grammar School",
    date: '2017',
  },
];
---

<section id="education" class="relative overflow-x-clip" aria-labelledby="edu-heading">
  <div class="edu-inner relative max-w-6xl mx-auto px-6 md:px-16 py-16 md:py-26">
    <p class="relative z-10 inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
      <span class="w-6 h-px bg-accent inline-block"></span>
      Education
    </p>

    <h2 id="edu-heading" class="relative z-10 font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[22ch] mb-10">
      Foundations in chemical engineering, from secondary school through university.
    </h2>

    <!-- mobile-only: soft background photo, sits behind the text -->
    <div class="edu-portrait-mobile md:hidden" aria-hidden="true">
      <Image
        src={portrait}
        alt=""
        widths={[420, 600, 760]}
        sizes="80vw"
        loading="lazy"
      />
    </div>

    <div class="edu-list max-w-md md:max-w-sm lg:max-w-md relative z-10">
      {edus.map((edu, i) => (
        <div class="edu-item exp-reveal" data-delay={i}>
          <div class="edu-marker" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10 12 5 2 10l10 5 10-5Z" />
              <path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
            </svg>
          </div>
          <div class="edu-content">
            <div class="edu-top">
              <h3 class="font-display font-semibold text-base text-ink">{edu.degree}</h3>
              {edu.honors && <span class="edu-honors">{edu.honors}</span>}
            </div>
            <p class="text-sm text-ink-soft mt-1">{edu.institution}</p>
            <p class="text-xs text-ink-soft/80 mt-1 uppercase tracking-wide">{edu.date}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- desktop-only: pinned to the true page edge (not just the container edge), large, vertically centered, hand reaching toward the text -->
    <div class="edu-portrait-desktop hidden md:block">
      <Image
        src={portrait}
        alt="Elizabeth Afolabi holding a hard hat"
        widths={[320, 440, 620, 760]}
        sizes="(min-width: 1280px) 22vw, 26vw"
        loading="lazy"
        class="edu-portrait-desktop-img"
      />
    </div>
  </div>
</section>

<style>
  .edu-list { display: flex; flex-direction: column; gap: 2rem; }
  .edu-item { display: flex; gap: 1.25rem; position: relative; }
  .edu-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.375rem;
    top: 2.75rem;
    bottom: -2rem;
    width: 1px;
    background: var(--color-border);
  }
  .edu-marker {
    width: 2.75rem; height: 2.75rem; flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
  }
  .edu-content { padding-top: 0.35rem; }

  .edu-portrait-mobile {
    position: absolute;
    top: 18%;
    right: 0;
    width: 80vw;
    height: clamp(440px, 95vw, 560px);
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;

    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.5) 30%, #000 75%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.5) 30%, #000 75%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 78%, transparent 100%);
    mask-composite: intersect;
  }
  .edu-portrait-mobile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Mobile only: give text a soft halo so it always wins over the photo */
  @media (max-width: 767px) {
    .edu-content {
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.95), 0 0 20px rgba(255, 255, 255, 0.8);
    }
    .edu-honors {
      background: #fff;
      text-shadow: none;
    }
  }

  .edu-portrait-desktop {
    position: absolute;
    top: 50%;
    right: calc(-50vw + 60%);
    transform: translateY(-50%);
    z-index: 1;
  }
  .edu-portrait-desktop :global(img) {
    display: block;
    height: clamp(300px, 50vw, 440px);
    width: auto;
    filter: drop-shadow(0 20px 34px rgba(15, 23, 42, 0.16));
  }

  .edu-top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .edu-honors {
    display: inline-flex; align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.7rem; font-weight: 600;
  }
  .exp-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .exp-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#education .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#education .exp-reveal').forEach((el) => observer.observe(el));
</script>