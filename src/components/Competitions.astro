---
// Competitions.astro
// Section 7 — Competitions & Recognition
//
import { Image } from 'astro:assets';
import cheméSportsPhoto from '../assets/images/competitions/chem-e-sports-overall.jpeg';

const categoryAwards = [
  '[ChemE Safety Sorceres Award(Lowest Alarms in Any Round) - 3rd Place]',
  '[Expert Award — 1st Place Round 2]',
  '[Master of Disaster Award — 1st Place Round 3]',
  '[Ultimate Controller Award — 2nd Place Round 4]',
];

const smallerWins = [
  {
    title: 'Secondary school innovation competition',
    result: '3rd place',
    year: null,
    description:
      'Early recognition for an innovation project during secondary school — the first sign of a competitive, hands-on streak that carried through into university.',
  },
  {
    title: 'ACE4G 2021',
    result: 'Documenter & researcher',
    year: '2021',
    description:
      'Contributed as documenter and researcher on a wastewater treatment project, handling the technical write-up and research groundwork for the team\'s entry.',
  },
];
---

<section id="competitions" class="px-6 py-24 md:px-12 lg:px-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 max-w-160">
      <h2 class="text-[clamp(1.875rem,3vw,2.5rem)] font-medium tracking-[-0.02em] text-ink">
        Competitions & recognition
      </h2>
      <p class="mt-3 text-lg text-ink-soft">
        Where the engineering leaves the classroom and gets tested against a clock, a judging panel, and other teams.
      </p>
    </div>

    <!-- Spotlight: ChemE-Sports 2022 -->
    <div
      class="exp-reveal grid grid-cols-1 overflow-hidden rounded-3xl border border-(--color-border) lg:grid-cols-[1.1fr_0.9fr]"
      data-delay="0"
    >
      <!-- Photo side -->
      <div class="relative min-h-80 bg-accent-soft lg:min-h-0">
        
          <Image
            src={cheméSportsPhoto}
            alt="Elizabeth Afolabi with the ChemE-Sports 2022 team"
            class="h-full w-full object-cover"
          />
       
        <div class="flex h-full w-full items-center justify-center p-8 text-center text-sm text-ink-soft">
          Photo slot — ChemE-Sports 2022 team photo
        </div>
        <div
          class="absolute left-6 top-6 flex size-16 flex-col items-center justify-center rounded-2xl bg-accent shadow-[0_2px_12px_rgba(15,23,42,0.12)]"
          aria-hidden="true"
        >
          <span class="text-2xl font-semibold leading-none text-white">2nd</span>
          <span class="mt-0.5 text-[0.65rem] text-ink">overall</span>
        </div>
      </div>

      <!-- Content side -->
      <div class="flex flex-col justify-center gap-6 p-8 md:p-10">
        <div>
          <p class="text-sm text-ink-soft">2022</p>
          <h3 class="mt-1 text-2xl font-medium tracking-[-0.01em] text-ink">
            ChemE-Sports
          </h3>
          <p class="mt-3 text-ink-soft">
            Finished 2nd overall against competing chemical engineering teams, on top of four
            individual category awards. A mix of technical, teamwork, and speed-based challenges
            built around real process-engineering problem solving.
          </p>
        </div>

        <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {categoryAwards.map((award) => (
            <li class="flex items-start gap-2 text-sm text-ink">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent"></span>
              <span>{award}</span>
            </li>
          ))}
        </ul>

        <p class="border-t border-(--color-border) pt-4 text-sm text-ink-soft">
          {/* TODO: fill in teammate names and coach credit once confirmed. */}
          Competed alongside teammates <span class="font-medium text-ink">David Akomolafe, Mariam Sanni and Ife Akinyemi</span>,
        </p>
      </div>
    </div>

    <!-- Smaller wins -->
    <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
      {smallerWins.map((win, i) => (
        <div
          class="exp-reveal rounded-2xl border border-(--color-border) p-7"
          data-delay={String((i + 1) * 0.08)}
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-lg font-medium text-ink">{win.title}</h3>
            {win.year && <span class="text-sm text-ink-soft">{win.year}</span>}
          </div>
          <p class="mt-1 text-sm font-medium text-accent">{win.result}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{win.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Reuses the exact scroll-reveal pattern from Experience.astro onward —
     IntersectionObserver + CSS transition, staggered via data-delay × 0.08s. */
  .exp-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0s);
  }

  .exp-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Same IntersectionObserver setup used for Certifications / Field Exposure —
  // if a shared observer utility already exists elsewhere in the project,
  // this block can be deduped in favor of that.
  const revealEls = document.querySelectorAll<HTMLElement>('#competitions .exp-reveal');

  revealEls.forEach((el) => {
    const delay = parseFloat(el.dataset.delay || '0');
    el.style.setProperty('--reveal-delay', `${delay}s`);
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  revealEls.forEach((el) => observer.observe(el));
</script>