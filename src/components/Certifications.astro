---
// src/components/Certifications.astro

import { Image } from 'astro:assets';

interface CertEntry {
  slug: string; 
  title: string;
  subtitle?: string;
  issuer: string;
  mono: string; 
  date: string; 
  score?: number;
  span?: string; 
}

const certImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/certifications/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

const bgImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/backgrounds/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

const find = (map: Record<string, { default: ImageMetadata }>, key: string) =>
  Object.entries(map).find(([path]) => path.includes(key))?.[1]?.default;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (d: string) => {
  const [, m, y] = d.split('/');
  return `${MONTHS[parseInt(m, 10) - 1]} ${y}`;
};

const WIDE = 'col-span-2';

const raw: CertEntry[] = [
  { slug: 'nse-graduate', title: 'Graduate Member', subtitle: 'Nigerian Society of Engineers', issuer: 'NSE', mono: 'NSE', date: '23/01/2026', span: 'col-span-2 md:row-span-2' },
  { slug: 'confined-space-entry', title: 'Confined Space Entry', issuer: 'NEXA', mono: 'NEXA', date: '14/02/2021', score: 90 },
  { slug: 'fire-safety-cert', title: 'Fire Safety Management', issuer: 'NEXA', mono: 'NEXA', date: '14/02/2021', score: 86 },
  { slug: 'sache-ela950', title: 'SAChE ELA950', subtitle: 'Process Safety Intro', issuer: 'AIChE SAChE', mono: 'SAChE', date: '28/02/2020' },
  { slug: 'sache-ela961', title: 'SAChE ELA961', subtitle: 'Toxicological Hazards', issuer: 'AIChE SAChE', mono: 'SAChE', date: '05/08/2020' },
  { slug: 'hse-level-1-2', title: 'HSE Level 1&2', issuer: 'Deeprimex Consulting', mono: 'HSE', date: '01/02/2021' },
  { slug: 'hse-level-3', title: 'HSE Level 3', issuer: 'Deeprimex Consulting', mono: 'HSE', date: '08/02/2021' },
  { slug: 'data-analytics', title: 'Data Analytics', issuer: 'LinkedIn Learning', mono: 'in', date: '05/02/2022' },
  { slug: 'spe-leadership', title: 'SPE Continuing Education Course', issuer: 'SPE', mono: 'SPE', date: '18/08/2020' },
  { slug: 'nsche-convention', title: 'NSChE Annual Convention', subtitle: 'Participation', issuer: 'NSChE', mono: 'NSChE', date: '29/09/2018', span: WIDE },
  { slug: 'nysc', title: 'NYSC Certificate', issuer: 'National Youth Service Corps', mono: 'NYSC', date: '23/09/2026', span: WIDE },
];

const certs = raw.map((c) => ({ ...c, image: find(certImages, c.slug) }));
const backdrop = find(bgImages, 'certifications');
---

<section id="certifications" class="relative overflow-hidden" aria-labelledby="certs-heading">
  {backdrop && (
    <div class="certs-backdrop" aria-hidden="true">
      <Image src={backdrop} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="lazy" class="size-full object-cover" />
    </div>
  )}

  <div class="relative max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26">
    <div class="max-w-[46ch] mb-10">
      <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
        <span class="w-6 h-px bg-accent inline-block"></span>
        Certifications
      </p>
      <h2 id="certs-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] m-0">
        A working library of safety and hazard-management credentials.
      </h2>
    </div>

    <ul class="certs-wall grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 list-none p-0 m-0" data-reveal-group>
      {certs.map((cert, i) => {
        const isFeature = cert.span?.includes('row-span-2');
        return (
          <li class={`exp-reveal ${cert.span ?? ''}`} data-delay={Math.min(i, 6)}>
            <figure class="cert-tile group m-0">
              {cert.image ? (
                <Image
                  src={cert.image}
                  alt={`${cert.title}, ${cert.issuer}`}
                  widths={isFeature ? [480, 800] : [320, 480, 640]}
                  sizes={isFeature ? '(min-width: 768px) 50vw, 92vw' : '(min-width: 768px) 25vw, 46vw'}
                  loading="lazy"
                  class="absolute inset-0 size-full object-cover object-center transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
              ) : (
                <div class="cert-mono" aria-hidden="true"><span>{cert.mono}</span></div>
              )}

              {cert.score && <span class="cert-score">{cert.score}%</span>}

              <figcaption class="cert-caption">
                <p class="text-xs text-white/80 m-0">{cert.issuer} &middot; {fmt(cert.date)}</p>
                <h3 class:list={['font-display font-bold tracking-tight leading-snug text-white m-0', isFeature ? 'text-xl md:text-3xl' : 'text-sm md:text-base']}>
                  {cert.title}
                </h3>
                {cert.subtitle && <p class="text-xs text-white/80 m-0 mt-0.5">{cert.subtitle}</p>}
              </figcaption>
            </figure>
          </li>
        );
      })}
    </ul>

    <p class="text-sm text-ink-soft mt-8 mb-0">
      Original certificates are available on request. <a href="#contact" class="text-accent font-semibold underline underline-offset-2">Get in touch</a>.
    </p>
  </div>
</section>

<style>
  .certs-backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: 26rem;
    opacity: 0.22;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 100%);
  }

  .certs-wall { grid-auto-rows: 11rem; }
  @media (min-width: 768px) { .certs-wall { grid-auto-rows: 13rem; } }
  .certs-wall > li { min-height: 0; }

  .cert-tile {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  .cert-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.45) 55%, transparent 100%);
  }

  .cert-score {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-accent);
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .cert-mono {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-ink) 100%);
  }
  .cert-mono span {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 700;
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.3);
  }

  /* Scroll reveal: same pattern as Experience.astro */
  .exp-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exp-reveal.is-in { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .exp-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#certifications [data-reveal-group]').forEach((group) => {
    const items = group.querySelectorAll<HTMLElement>('.exp-reveal');
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = parseInt(el.getAttribute('data-delay') || '0', 10);
            el.style.transitionDelay = `${delay * 0.08}s`;
            el.classList.add('is-in');
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((el) => observer.observe(el));
  });
</script>