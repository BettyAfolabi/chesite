---
import { Image } from 'astro:assets';

interface CertEntry {
  slug: string;
  title: string;
  subtitle?: string;
  issuer: string;
  date: string;
  score?: string;
  pdf?: string;
}

const certImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/certifications/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

function findImage(slug: string) {
  const match = Object.entries(certImages).find(([path]) => path.includes(slug));
  return match?.[1]?.default;
}

const certs: (CertEntry & { image?: ImageMetadata })[] = [
  { slug: 'hse-level-1-2', title: 'HSE Level 1&2', issuer: 'Deeprimex Consulting', date: '01/02/2021', pdf: '/certifications/hse-level-1-2.pdf' },
  { slug: 'hse-level-3', title: 'HSE Level 3', issuer: 'Deeprimex Consulting', date: '08/02/2021', pdf: '/certifications/hse-level-3.pdf' },
  { slug: 'sache-ela950', title: 'SAChE ELA950', subtitle: 'Process Safety Intro', issuer: 'AIChE SAChE', date: '28/02/2020', pdf: '/certifications/sache-ela950.pdf' },
  { slug: 'sache-ela961', title: 'SAChE ELA961', subtitle: 'Toxicological Hazards', issuer: 'AIChE SAChE', date: '05/08/2020', pdf: '/certifications/sache-ela961.pdf' },
  { slug: 'nexa-confined-space', title: 'Confined Space Entry', issuer: 'NEXA', date: '14/02/2021', score: '90%', pdf: '/certifications/confined-space-entry-cert.pdf' },
  { slug: 'nexa-fire-safety', title: 'Fire Safety Management', issuer: 'NEXA', date: '14/02/2021', score: '86%', pdf: '/certifications/fire-safety-cert.pdf' },
  { slug: 'linkedin-data-analytics', title: 'Data Analytics', issuer: 'LinkedIn Learning', date: '05/02/2022', pdf: '/certifications/data-analytics.pdf' },
  { slug: 'spe-leadership', title: 'SPE Continuing Education Course', issuer: 'SPE', date: '18/08/2020', pdf: '/certifications/spe-leader.pdf' },
  { slug: 'nsche-convention', title: 'Participation - NSChE Annual Convention', issuer: 'NSChE', date: '29/09/2018' },
  { slug: 'nse-graduate', title: 'Graduate Member', issuer: 'Nigerian Society of Engineers', date: '23/01/2026', pdf: '/certifications/nse-graduate-member.pdf' },
  { slug: 'nysc', title: 'NYSC CERT', issuer: 'National Youth Service Corps', date: '23/09/2026' },
].map((cert) => ({ ...cert, image: findImage(cert.slug) }));
---

<section id="certifications" class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26" aria-labelledby="certs-heading">
  <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
    <span class="w-6 h-px bg-accent inline-block"></span>
    Certifications
  </p>

  <h2 id="certs-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[22ch] mb-10">
    A working library of safety and hazard-management credentials.
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
    {certs.map((cert, i) => (
      <div
        class="cert-card exp-reveal"
        data-delay={i}
        tabindex="0"
        aria-label={`${cert.title}, issued by ${cert.issuer}. Focus or hover for details.`}
      >
        <div class="cert-card-inner">
          <div class="cert-face cert-front">
            <span class="w-9 h-9 rounded-lg bg-accent-soft text-accent flex items-center justify-center mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 12 2 2 4-4" />
                <circle cx="12" cy="12" r="9" />
              </svg>
            </span>
            <span class="font-display font-semibold text-sm text-ink leading-snug block">{cert.title}</span>
            {cert.subtitle && <span class="text-xs text-ink-soft mt-1 block">{cert.subtitle}</span>}
          </div>

          <div class="cert-face cert-back">
            {cert.image ? (
              <>
                <Image
                  src={cert.image}
                  alt={`${cert.title} certificate`}
                  widths={[320, 480]}
                  sizes="(min-width: 900px) 240px, 45vw"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="cert-back-overlay">
                  <span class="text-xs uppercase tracking-widest text-white/80 font-semibold block">{cert.issuer}</span>
                  <span class="text-sm text-white block">{cert.date}</span>
                  {cert.score && <span class="text-sm font-semibold text-white block">{cert.score}</span>}
                </div>
              </>
            ) : cert.pdf ? (
              <div class="cert-back-placeholder">
                <span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{cert.issuer}</span>
                <span class="text-sm text-ink block mb-1">{cert.date}</span>
                {cert.score && <span class="text-sm font-semibold text-ink block mb-2">{cert.score}</span>}
                <a
                  href={cert.pdf}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-pdf-link inline-flex items-center gap-1.5 text-xs font-semibold text-accent mt-1"
                  onclick="event.stopPropagation()"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6" />
                  </svg>
                  View certificate
                </a>
              </div>
            ) : (
              <div class="cert-back-placeholder">
                <span class="text-xs uppercase tracking-widest text-accent font-semibold mb-2 block">{cert.issuer}</span>
                <span class="text-sm text-ink block mb-1">{cert.date}</span>
                {cert.score && <span class="text-sm font-semibold text-ink block">{cert.score}</span>}
                <span class="text-[0.7rem] text-ink-soft mt-2 block">No file yet</span>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .cert-card { perspective: 1000px; aspect-ratio: 4 / 3; cursor: pointer; outline: none; }
  .cert-card-inner {
    position: relative; width: 100%; height: 100%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }
  .cert-card:hover .cert-card-inner,
  .cert-card:focus-visible .cert-card-inner { transform: rotateY(180deg); }
  .cert-face {
    position: absolute; inset: 0; backface-visibility: hidden;
    border-radius: 1rem; border: 1px solid var(--color-hairline); overflow: hidden;
  }
  .cert-front {
    background: var(--color-paper); padding: 1.25rem;
    display: flex; flex-direction: column; justify-content: center;
  }
  .cert-back { transform: rotateY(180deg); background: var(--color-accent-soft); }
  .cert-back-overlay {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    justify-content: flex-end; padding: 0.9rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.75) 0%, rgba(15, 23, 42, 0.15) 55%, transparent 100%);
  }
  .cert-back-placeholder { padding: 1.25rem; height: 100%; display: flex; flex-direction: column; justify-content: center; }
  .cert-pdf-link { text-decoration: underline; text-underline-offset: 2px; }
  .cert-card:focus-visible { box-shadow: 0 0 0 2px var(--color-accent); border-radius: 1rem; }
  .exp-reveal {
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .cert-card-inner { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#certifications .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#certifications .exp-reveal').forEach((el) => observer.observe(el));
</script>