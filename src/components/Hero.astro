---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.png';
---


<header class="max-w-7xl mx-auto px-6 md:px-16 pt-8 md:pt-12 pb-16 md:pb-20 grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-12 md:gap-8 items-center">
  <div>
    <p class="reveal reveal-1 inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
      <span class="w-6 h-px bg-accent inline-block"></span>
      Chemical Engineer
    </p>

    <h1 class="reveal reveal-2 font-display font-extrabold tracking-tight leading-[1.02] text-[clamp(2.5rem,5.2vw,4rem)] mb-4">
      Elizabeth Afolabi
    </h1>

    <p class="reveal reveal-3 text-[clamp(1.05rem,1.7vw,1.25rem)] text-ink-soft max-w-[34ch] leading-relaxed mb-6">
      Process safety, simulation, and research — engineered from the lab bench to the plant floor.
    </p>

    <div class="reveal reveal-3 flex flex-wrap gap-2 mb-9">
      <span class="text-sm font-medium px-3.5 py-1.5 rounded-full border border-slate-200 bg-white">Process Safety</span>
      <span class="text-sm font-medium px-3.5 py-1.5 rounded-full border border-slate-200 bg-white">Simulation</span>
      <span class="text-sm font-medium px-3.5 py-1.5 rounded-full border border-slate-200 bg-white">Research</span>
    </div>

    <div class="reveal reveal-4 flex flex-wrap gap-3">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-xl bg-accent text-white transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/25 focus-visible:outline focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        Get in touch
      </a>
      <a
        href="/resume/elizabeth-afolabi.pdf"
        download
        class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3.5 rounded-xl bg-white text-ink border border-slate-200 transition hover:-translate-y-0.5 hover:text-accent hover:border-accent focus-visible:outline focus-visible:outline-accent focus-visible:outline-offset-2"
      >
        Download résumé
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
      </a>
    </div>
  </div>

  <div class="relative justify-self-center w-full max-w-90">
    <div class="reveal reveal-1 frame-accent relative aspect-4/5 rounded-2xl border border-slate-200 bg-accent-soft overflow-hidden">
      <Image
        src={headshot}
        alt="Elizabeth Afolabi"
        widths={[360, 720]}
        sizes="(min-width: 900px) 360px, 80vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <div class="reveal reveal-2 chip absolute -left-5 bottom-7 bg-white border border-slate-200 rounded-xl px-3.5 py-2.5 flex items-center gap-2.5 shadow-[0_12px_28px_-12px_rgba(15,23,42,0.18)] max-w-55">
      <span class="w-8 h-8 rounded-lg bg-accent-soft text-accent flex items-center justify-center shrink-0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m4 15 8 4 8-4V9L12 5 4 9v6Z"/><path d="M12 12v9"/></svg>
      </span>
      <span>
        <span class="block text-[0.7rem] text-ink-soft leading-tight">NSE</span>
        <span class="block text-[0.8rem] font-semibold text-ink leading-tight">Graduate Member</span>
      </span>
    </div>
  </div>
</header>

<style>
  .frame-accent::after {
    content: "";
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1.5px solid var(--color-accent);
    border-radius: 1rem;
    z-index: -1;
  }

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: reveal-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .reveal-1 { animation-delay: 0.05s; }
  .reveal-2 { animation-delay: 0.16s; }
  .reveal-3 { animation-delay: 0.27s; }
  .reveal-4 { animation-delay: 0.38s; }

  .frame-accent.reveal { transform: translateY(10px) scale(0.98); }
  .chip.reveal { transform: translateY(6px) scale(0.9); animation-delay: 0.75s; }

  @keyframes reveal-up {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
