---
import { Image } from 'astro:assets';

interface ExposureEntry {
  slug: string;
  title: string;
  org: string;
  date: string;
  blurb?: string;
}

const exposureImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/field-exposure/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

function findImage(slug: string) {
  const match = Object.entries(exposureImages).find(([path]) => path.includes(slug));
  return match?.[1]?.default;
}

const exposures: (ExposureEntry & { image?: ImageMetadata })[] = [
  { slug: 'mobil-plant', title: 'Mobil Plant Visit', org: 'Mobil', date: '2019' },
  { slug: 'abinbev-brewery', title: 'ABInBev Brewery Visit', org: 'ABInBev', date: '2022' },
  { slug: 'ascin-conference', title: 'AScIN Conference', org: 'AScIN', date: '2022' },
  { slug: 'environmental', title: 'Local Community Sensitization', org: 'SPE OAU', date: '2023' },
  { slug: 'yes-summit', title: 'YES Summit', org: 'YES', date: '2023' },
  { slug: 'spe-symposium', title: 'Young Professional Symposium', org: 'SPE', date: '2022' },
  { slug: 'aiche-exchange', title: 'Sister Chapter Exchange', org: 'AIChE', date: '2021' },
  { slug: 'nsche-convention', title: 'NSChE Annual Convention', org: 'NSChE', date: '2018' },
].map((entry) => ({ ...entry, image: findImage(entry.slug) }));
---

<section id="field-exposure" class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-26" aria-labelledby="exposure-heading">
  <p class="inline-flex items-center gap-2 font-semibold text-xs tracking-[0.14em] uppercase text-accent mb-4">
    <span class="w-6 h-px bg-accent inline-block"></span>
    Field Exposure & Involvement
  </p>

  <h2 id="exposure-heading" class="font-display font-bold tracking-tight leading-[1.15] text-[clamp(1.6rem,2.8vw,2.1rem)] max-w-[24ch] mb-10">
    Time on plant floors, at conferences, and in rooms building the next cohort of engineers.
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
    {exposures.map((item, i) => (
      <figure
        class="exposure-card exp-reveal"
        data-delay={i}
        tabindex="0"
        aria-label={`${item.title}, ${item.org}, ${item.date}`}
      >
        {item.image ? (
          <>
            <div class="exposure-media">
              <Image
                src={item.image}
                alt={`${item.title} — ${item.org}, ${item.date}`}
                widths={[320, 480]}
                sizes="(min-width: 900px) 240px, 45vw"
                loading="lazy"
                class="exposure-img"
              />
            </div>
            <figcaption class="exposure-caption">
              <span class="text-xs uppercase tracking-widest text-white/80 font-semibold block">{item.org}</span>
              <span class="text-sm text-white block">{item.title}</span>
              <span class="text-xs text-white/70 block mt-0.5">{item.date}</span>
            </figcaption>
          </>
        ) : (
          <div class="exposure-pending">
            <span class="w-9 h-9 rounded-lg bg-accent-soft text-accent flex items-center justify-center mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <path d="m21 15-5-5L5 21" />
              </svg>
            </span>
            <figcaption>
              <span class="text-xs uppercase tracking-widest text-accent font-semibold block mb-1">{item.org}</span>
              <span class="text-sm text-ink font-semibold block leading-snug">{item.title}</span>
              <span class="text-xs text-ink-soft block mt-1">{item.date}</span>
              <span class="text-[0.7rem] text-ink-soft mt-2 block">Photo pending</span>
            </figcaption>
          </div>
        )}
      </figure>
    ))}
  </div>
</section>

<style>
  .exposure-card {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    outline: none;
    cursor: pointer;
  }
  .exposure-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .exposure-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exposure-card:hover .exposure-img,
  .exposure-card:focus-visible .exposure-img {
    transform: scale(1.08);
  }
  .exposure-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.9rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.8) 0%, rgba(15, 23, 42, 0.25) 55%, transparent 100%);
    pointer-events: none;
  }
  .exposure-pending {
    height: 100%;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-accent-soft);
  }
  .exposure-card:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
  }
  .exp-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--reveal-delay, 0) * 0.08s);
  }
  .exp-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .exposure-img { transition: none; }
    .exposure-card:hover .exposure-img,
    .exposure-card:focus-visible .exposure-img { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#field-exposure .exp-reveal').forEach((el) => {
    const delay = el.getAttribute('data-delay');
    if (delay) el.style.setProperty('--reveal-delay', delay);
  });
  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('#field-exposure .exp-reveal').forEach((el) => observer.observe(el));
</script>